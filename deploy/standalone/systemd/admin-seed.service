[Unit]
Description=Seed default admin account (runs once after controller is ready)
After=controller.service
Requires=controller.service

[Service]
Type=oneshot
# Retry until the controller API accepts the registration (or reports that an
# admin already exists – HTTP 403).  Any other failure (connection refused,
# 5xx, etc.) causes a 2-second sleep before the next attempt.
ExecStart=/bin/bash -c '\
  while true; do \
    status=$(curl -s -o /dev/null -w "%{http_code}" \
      -X POST http://localhost:8000/api/auth/admin/register \
      -H "Content-Type: application/json" \
      -d "{\"email\":\"demo@gmail.com\",\"name\":\"Demo\",\"password\":\"standalone\"}"); \
    if [ "$status" = "200" ] || [ "$status" = "201" ] || [ "$status" = "403" ]; then \
      echo "admin-seed: done (HTTP $status)"; \
      break; \
    fi; \
    echo "admin-seed: got HTTP $status, retrying in 2s..."; \
    sleep 2; \
  done'

RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
